      "text": "./\n    prisma/\n        schema.prisma \n\n    src/\n        app/\n            auth/ \n                login/\n                    page.tsx\n\n            dashboard/ \n                layout.tsx\n                page.tsx \n                integration/\n                    page.tsx\n\n            p/[token]/\n                page.tsx\n\n            api/\n                auth/[...nextauth]/\n                    route.ts\n                configs/\n                    route.ts\n                stats/\n                    route.ts\n                sync/\n                    route.ts\n                public/[token]/\n                    route.ts\n\n        components/\n            QRCodeGenerator.tsx\n            StatsDashboard.tsx\n            ShareLinkManager.tsx\n\n        lib/\n            db.ts\n            redis.ts\n            rust-api-client.ts\n            crypto.ts\n\n        store/\n            userStore.ts\n\n        types/\n            index.ts",
